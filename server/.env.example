# Server di sviluppo: Postgres da deploy/compose.yml (docker compose -f deploy/compose.yml up -d postgres)
DATABASE_URL=postgres://athenai:athenai-dev@127.0.0.1:55432/athenai
PORT=8787
# solo in sviluppo: account di prova senza OIDC
ALLOW_TRIAL=true
# con Zitadel (deploy/README.md):
# OIDC_ISSUER=http://localhost:8080
# OIDC_AUDIENCE=<client id dell'app>
